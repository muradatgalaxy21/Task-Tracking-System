// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth standard models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models (Using snake_case to match existing UI types)
model User {
  id            String    @id @default(cuid())
  full_name     String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  dob           DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  role          String    @default("Member")
  task_deadline_order String @default("asc")
  accepted_privacy_policy Boolean @default(false)
  // Set whenever the password changes; JWTs issued before this instant are rejected
  // in the session callback so a reset invalidates all existing sessions.
  password_changed_at DateTime?

  workspaces           Workspace[]       @relation("CreatedWorkspaces")
  memberships          WorkspaceMember[]
  tasks                TaskLedger[]
  attendance           DailyAttendance[]
  notifications        Notification[]
  invitations_created  Invitation[]      @relation("InvitationsCreated")
  chat_messages        ChatMessage[]
  announcements        Announcement[]
  penalties            Penalty[]
  permissions          MemberPermission[]
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  // Nullable so existing workspaces remain valid after migration.
  // New workspaces always receive a code on creation.
  invite_code String?  @unique
  created_by  String?
  created_at  DateTime @default(now())

  createdBy      User?               @relation("CreatedWorkspaces", fields: [created_by], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]
  pages          Page[]
  tasks          TaskLedger[]
  invitations    Invitation[]
  chat_messages  ChatMessage[]
  monthly_closes MonthlyClose[]
  announcements  Announcement[]
  penalties      Penalty[]
  permissions    MemberPermission[]
}

model WorkspaceMember {
  workspace_id String
  user_id      String
  role         String   @default("Member")
  joined_at    DateTime @default(now())

  workspace   Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
}

model Page {
  id           String   @id @default(uuid())
  workspace_id String
  title        String
  page_type    String   @default("tasks")
  created_at   DateTime @default(now())

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model TaskLedger {
  task_id           String    @id @default(uuid())
  workspace_id      String?
  title             String
  description       String    @default("")
  assignee_id       String
  estimated_days    Int       @default(1)
  status            String    @default("Todo")
  priority          String?
  max_deadline      DateTime
  created_at           DateTime  @default(now())
  completed_at         DateTime?
  // Set when task is first moved to "In Review" — used for fair multiplier calculation.
  review_submitted_at  DateTime?
  multiplier_earned    Float?

  ai_model_used   String?
  benchmark_score String?
  repo_link       String?

  // Deep Dive panel fields
  technical_requirements String @default("")
  architecture_notes     String @default("")
  estimated_hours        Float?
  actual_hours           Float?
  attachments            String @default("[]")

  workspace       Workspace?     @relation(fields: [workspace_id], references: [id], onDelete: SetNull)
  assignee        User           @relation(fields: [assignee_id], references: [id], onDelete: Cascade)
  sub_tasks       SubTask[]
  activities      TaskActivity[]

  // Kanban/list views filter by workspace and status
  @@index([workspace_id, status])
  // Monthly close and member history aggregate completed tasks per assignee within a workspace
  @@index([workspace_id, assignee_id])
  // Deadline-alert cron scans non-terminal tasks ordered by deadline
  @@index([status, max_deadline])
}

model TaskActivity {
  id         String   @id @default(uuid())
  task_id    String
  user_id    String?
  actor_name String?
  // "comment" | "status_change" | "field_update" | "attachment"
  type       String
  content    String
  metadata   String?
  created_at DateTime @default(now())

  task       TaskLedger @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
}

model SubTask {
  id             String   @id @default(uuid())
  parent_task_id String
  title          String
  description    String   @default("")
  status         String   @default("Todo")
  created_at     DateTime @default(now())

  parent_task    TaskLedger @relation(fields: [parent_task_id], references: [task_id], onDelete: Cascade)
}

model DailyAttendance {
  id         String   @id @default(uuid())
  user_id    String
  date       DateTime
  status     String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  // Admin attendance log and cron jobs filter by date alone across all users
  @@index([date])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  task_id    String?
  task_title String?
  from_name  String
  type       String   @default("mention")
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user       User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Stores short-lived tokens used for the password reset flow.
// Each token is deleted immediately after use or when a new one is issued for the same email.
model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

// Single-use workspace invitation codes.
// Admin/Owner-generated invites are ACTIVE (instant join).
// Member-generated invites start PENDING_APPROVAL; a claimer is recorded when
// someone tries to use the code and an admin must approve before they join.
model Invitation {
  id                 String    @id @default(cuid())
  code               String    @unique
  email              String?
  workspace_id       String
  invited_by_id      String
  // True when created by a workspace Admin or Owner
  is_admin_generated Boolean   @default(false)
  // PENDING_APPROVAL | ACTIVE | USED | EXPIRED
  status             String    @default("PENDING_APPROVAL")
  created_at         DateTime  @default(now())
  expires_at         DateTime?
  // Set when a user attempts to use a PENDING_APPROVAL code
  claimer_id         String?
  claimer_email      String?
  claimed_at         DateTime?

  workspace          Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  invited_by         User      @relation("InvitationsCreated", fields: [invited_by_id], references: [id], onDelete: Cascade)
}

// Central audit log for admin oversight. Captures task lifecycle events and auth events.
// workspace_id is null for auth events (login / signup).
model AuditLog {
  id           String   @id @default(uuid())
  workspace_id String?
  user_id      String?
  actor_name   String
  actor_email  String?
  // task_created | task_deleted | task_status_change | task_edited | task_comment | user_login | user_signup
  event_type   String
  entity_id    String?  // task_id or user_id
  entity_name  String?  // task title or user name
  metadata     String?  // JSON — extra fields (old/new status, field name, etc.)
  created_at   DateTime @default(now())
}

// Holds a pending profile update for Admin/Owner users that requires
// email link confirmation before the database is mutated.
model ProfileVerificationToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  // JSON-encoded profile fields to apply once the link is clicked
  payload    String
  expires_at DateTime
  created_at DateTime @default(now())
}

model ChatMessage {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String
  content      String
  attachments  String   @default("[]") // JSON string of [{ name: string, url: string, type: string }]
  created_at   DateTime @default(now())

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AccountDeletionToken {
  id         String   @id @default(cuid())
  user_id    String   @unique
  token      String   @unique
  payload    String   // JSON string of { transfers: Record<workspaceId, newOwnerUserId>, workspacesToDelete: string[] }
  expires_at DateTime
  created_at DateTime @default(now())
}

// Stores a pending email change request. A verification link is sent to the new
// email address; clicking it applies the change and deletes the token.
model EmailChangeToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  new_email  String
  expires_at DateTime
  created_at DateTime @default(now())
}

// Announcements created by Admin (global) or workspace Owner/Admin.
// workspace_id is null for global announcements visible to all users.
// type controls the banner color: "info" | "warning" | "urgent".
model Announcement {
  id           String    @id @default(uuid())
  workspace_id String?
  user_id      String
  content      String
  // "info" | "warning" | "urgent"
  type         String    @default("info")
  active       Boolean   @default(true)
  created_at   DateTime  @default(now())
  expires_at   DateTime?

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Stores each owner-initiated month-end close for a workspace.
// A close now spans a range of calendar months (start_month/start_year through
// month/year, which is kept as the range's END month for backward compatibility
// with existing ordering/display code). Single-month closes have start == end.
// "Draft" while owner reviews scores; "Finalized" once locked and salaries recorded.
model MonthlyClose {
  id             String    @id @default(uuid())
  workspace_id   String
  label          String    // e.g. "May 2026" or "Feb-May 2026" for a multi-month span
  start_month    Int       @default(0)  // 0-indexed (0=Jan, 11=Dec) — first month included
  start_year     Int       @default(2024)
  month          Int       // 0-indexed — last (end) month included
  year           Int       // end year
  period_end     DateTime  // actual calendar date the close was run
  total_revenue  Float     @default(0)
  scheduled_days Int       @default(25) // total working days counted across the whole span
  // "Draft" | "Finalized"
  status         String    @default("Draft")
  created_by     String    // user_id of the Owner who ran the close
  created_at     DateTime  @default(now())
  finalized_at   DateTime?

  workspace Workspace             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  payouts   MemberMonthlyPayout[]
}

// Stores each member's finalized score and payout for a given MonthlyClose.
model MemberMonthlyPayout {
  id           String  @id @default(uuid())
  close_id     String
  workspace_id String
  user_id      String
  tps_score    Float   @default(0)
  as_score     Float   @default(0)
  total_score  Float   @default(0)
  base_payout  Float   @default(0)
  perf_payout  Float   @default(0)
  final_payout Float   @default(0)
  penalty_deduction Float @default(0)
  highest_score_bonus Float @default(0)
  present_days   Float   @default(0)
  scheduled_days Int     @default(25)
  // JSON string: { [taskId]: overrideMultiplier } — non-destructive override applied at close time
  multiplier_overrides String @default("{}")
  // JSON string: per-month breakdown array [{year,month,tpsScore,asScore,totalScore,presentDays,scheduledDays}]
  // powering the close preview/audit view when a close spans multiple months
  monthly_breakdown String @default("[]")
  created_at   DateTime @default(now())

  monthly_close MonthlyClose @relation(fields: [close_id], references: [id], onDelete: Cascade)

  // Per-user payout balance lookup within a close
  @@index([close_id, user_id])
  // User history page aggregates a member's finalized payouts within a workspace
  @@index([workspace_id, user_id])
}

// Fixed-window rate-limit counters. Keyed by "<bucket>:<identifier>" (e.g.
// "login:1.2.3.4"). Backed by the DB so the limit holds across serverless
// instances, unlike an in-memory counter that resets on every cold start.
model RateLimit {
  key        String   @id
  count      Int      @default(0)
  expires_at DateTime

  // Lets a cleanup job prune expired windows efficiently
  @@index([expires_at])
}

model MemberPermission {
  id           String    @id @default(uuid())
  workspace_id String
  user_id      String
  permission   String
  allowed      Boolean   @default(true)

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id, permission])
}

model Penalty {
  id           String    @id @default(uuid())
  workspace_id String
  user_id      String
  amount       Float
  reason       String
  month        Int       // 0-indexed
  year         Int
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  created_by   String    // user_id of the Owner

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, user_id, year, month])
}
